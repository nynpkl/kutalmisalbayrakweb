# Supabase (Project Settings > API)
NUXT_SUPABASE_URL=https://xxxxx.supabase.co
NUXT_SUPABASE_SERVICE_KEY=service_role_key_buraya

# /admin paneline giriş şifresi
NUXT_ADMIN_PASSWORD=guclu-bir-sifre-belirleyin

# nuxt-auth-utils oturum çerezini şifrelemek için rastgele, en az 32 karakterlik bir metin
NUXT_SESSION_PASSWORD=en-az-32-karakter-uzunlugunda-rastgele-bir-metin-buraya
